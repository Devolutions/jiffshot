<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the Jiffshot MSI with WixSharp (WiX 3.14). Running this program
    authors and compiles the package; Program.cs lists its arguments, and the
    README shows the command.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Jiffshot.Package</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Company>Devolutions Inc.</Company>
    <Product>Devolutions Jiffshot</Product>
    <Description>Jiffshot MSI packager</Description>
    <Copyright>Copyright (c) Devolutions Inc.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Its build target would run the program after every build, with its own arguments. -->
    <PackageReference Include="WixSharp" Version="1.25.1" ExcludeAssets="build" />
    <PackageReference Include="WixSharp.bin" Version="1.25.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="out\**" />
    <Compile Remove="out\**" />
  </ItemGroup>

</Project>
